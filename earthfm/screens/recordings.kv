<ELabel@MDLabel>:
    theme_font_size:"Custom"
    theme_font_name:"Custom"


<Recording>:
    data:{}
    size_hint_x:None
    orientation:'vertical'
    padding: dp(10)
    on_release:app.play(self.data)
    canvas:
        Color:
            rgba:[0,0,0,0]
            group:"color"
        RoundedRectangle:
            size:self.size
            pos:self.pos
            radius:root.radius
        RoundedRectangle:
            size:self.size
            pos:self.pos
            radius:root.radius
            group:"img"
        RoundedRectangle:
            size:self.size
            pos:self.pos
            radius:root.radius
            source:app.get_file("assets/shadow-black.png")

    Widget:

    ELabel:
        id:rtext
        markup:True
        text:""
        adaptive_height:True
        text_color:app.white_color

<MoodSection>:
    max_entries:10
    size_hint_y:None
    height:dp(200)
    mood:""
    orientation:'vertical'
    data:{}
    
    ELabel:
        text:root.mood
        font_name:app.bold_font
        font_size:"25sp"
        theme_text_color:"Custom"
        text_color:app.theme_cls.primaryColor
        adaptive_height:True

    MDRecycleView:
        data:root.data
        key_viewclass: 'viewclass'
        do_scroll_y: False
        do_scroll_x:True
        bar_color:0,0,0,0
        bar_inactive_color:self.bar_color
        effect_cls: "ScrollEffect"
        RecycleBoxLayout:
            default_size_hint: None, 1
            default_size: self.height, 1
            spacing:dp(10)
            size_hint_x:None
            width:self.minimum_width

MDScreen:
    name:"recordings"

    MDLoadingIndicator:
        id:indicator
        shape_size:dp(100)
    
    MDScrollView:
        
        do_scroll_y:True
        do_scroll_x:False

        BoxLayout:
            id:container
            orientation:'vertical'
            size_hint_y:None
            padding: [dp(10), dp(10)]
            height:self.minimum_height
            spacing:dp(20)
            
            ELabel:
                text:"EarthFM"
                font_size:"45sp"
                font_name:app.main_font
                theme_text_color:"Custom"
                text_color:app.theme_cls.primaryColor
                padding:[0, 0, 0, dp(15)]
                adaptive_height:True

    BoxLayout:
        id:small_player
        pos_hint:{"center_x":0.5}
        y:0
        size_hint_y:None
        height:self.minimum_height
        spacing: dp(10)
        padding: [dp(10), dp(10)]

        canvas:
            Color:
                rgba:app.theme_cls.surfaceContainerHighestColor
            RoundedRectangle:
                size:self.size
                pos:self.pos
                radius:[dp(20), dp(20), 0, 0]
        
        RoundedImage:
            id:p_img
            size_hint_x:None
            width:self.height
            radius:[dp(10)]*4

            MDIconButton:
                icon: "play"
                style: "filled"

        BoxLayout:
            orientation: 'vertical'
            size_hint_y:None
            height:self.minimum_height

            ELabel:
                id:t_text
                markup:True
                text:" "
                shorten:True
                shorten_from:"right"
                adaptive_height:True
                font_name:app.bold_font

            ELabel:
                id:a_text
                text:" "
                font_name:app.regular_font
                font_size:"14sp"
                adaptive_height:True

            Widget:
                size_hint_y:None
                height:dp(10)
                            

            BoxLayout:

                size_hint_y:None
                height:dp(50)
                orientation: 'vertical'
                spacing:dp(8)

                WaveProgressIndicator:
                    id:pg_bar

                BoxLayout:
                    size_hint_y:None
                    height:dp(10)
                    ELabel:
                        text:"0:00"
                        font_size:"13sp"
                        font_name:app.medium_font
                        adaptive_size:True
                    Widget:
                    ELabel:
                        text:"1:46:00"
                        font_size:"13sp"
                        font_name:app.medium_font
                        adaptive_size:True
